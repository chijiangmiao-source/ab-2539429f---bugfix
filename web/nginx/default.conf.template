server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # web service health endpoint
    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ok","service":"web"}';
    }

    # reverse-proxy API calls to the api compose service; the internal
    # address is configurable via API_UPSTREAM (host:port)
    location /api/ {
        proxy_pass         http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location = /api {
        proxy_pass         http://${API_UPSTREAM}/api;
        proxy_set_header   Host $host;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
